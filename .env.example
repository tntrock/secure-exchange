# Copy to .env and fill in. Never commit .env.

# --- Deployment (used by docker-compose.yml) ---
# REQUIRED: public DNS name Caddy obtains a certificate for (use "localhost" for a local trial).
SX_DOMAIN=files.example.com
# REQUIRED: password of the bundled PostgreSQL (letters/digits only, it is placed in a URL).
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=
# Optional: host ports for Caddy (default 80/443).
#SX_HTTP_PORT=80
#SX_HTTPS_PORT=443

# --- Application (SX_*) ---
# Listen address inside the container.
#SX_LISTEN=:8080
# Public base URL; compose sets it from SX_DOMAIN (required when running the binary directly).
#SX_BASE_URL=https://files.example.com
# PostgreSQL connection URL; compose sets it from POSTGRES_PASSWORD (required when running directly).
#SX_DATABASE_URL=postgres://sx:pw@localhost:5432/sx?sslmode=disable
# Master keys, "id:base64key" entries separated by commas. Generate a key: openssl rand -base64 32
# Losing the master key means stored files can no longer be decrypted. BACK IT UP.
SX_MASTER_KEYS=1:REPLACE_WITH_openssl_rand_-base64_32
# Id of the key in SX_MASTER_KEYS used for new encryption (positive integer).
SX_ACTIVE_KEY_ID=1
# Blob storage backend: local or s3.
#SX_STORAGE=local
# Directory for encrypted blobs when SX_STORAGE=local.
#SX_STORAGE_DIR=/data/blobs
# Directory for encrypted in-progress uploads.
#SX_STAGING_DIR=/data/staging
# S3 endpoint host:port (SX_STORAGE=s3).
#SX_S3_ENDPOINT=s3.example.com
# S3 bucket (required when SX_STORAGE=s3).
#SX_S3_BUCKET=secure-exchange
#SX_S3_ACCESS_KEY=
#SX_S3_SECRET_KEY=
#SX_S3_REGION=
# true to use TLS to the S3 endpoint.
#SX_S3_USE_SSL=true
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted (compose sets it).
#SX_TRUSTED_PROXIES=
# Maximum upload size in bytes (default 500 GiB).
#SX_MAX_FILE_SIZE=536870912000
# Login session lifetime, Go duration (default 12h).
#SX_SESSION_TTL=12h
# First administrator, created on first start if no users exist.
SX_INIT_ADMIN_EMAIL=admin@example.com
# REQUIRED on first start: choose a long passphrase (without it no admin is created and nobody can log in).
SX_INIT_ADMIN_PASSWORD=

# --- Mail (SMTP) for share invitations, verification codes and notifications ---
# REQUIRED: SMTP server host (e.g. smtp.example.com).
SX_SMTP_HOST=
# SMTP port (default 587).
#SX_SMTP_PORT=587
# SMTP login; leave empty for a relay that needs none.
#SX_SMTP_USERNAME=
#SX_SMTP_PASSWORD=
# REQUIRED: sender address, e.g. "Secure Exchange <noreply@example.com>".
SX_SMTP_FROM=
# Transport security: starttls (default), tls (implicit TLS, usually port 465) or none (only for localhost/127.0.0.1/mailpit, local testing).
#SX_SMTP_TLS=starttls
# Longest allowed share lifetime in days (default 30).
#SX_SHARE_MAX_DAYS=30

# --- Online viewer (preview worker) ---
# Sizing rule: the worker copies the decrypted input into /work and writes all rendered
# output there too, and tmpfs pages count against the container memory limit. Keep
#   largest preview input + its rendered output <= /work tmpfs size (4g) < mem_limit (6g)
# with swap disabled (memswap_limit = mem_limit) -- see the worker service in docker-compose.yml.
# Raising a limit below means raising the tmpfs size and mem_limit with it. A job that still
# fills /work ends as "too_large".
# Largest document/image that gets a preview, bytes (default 1 GiB; input + PDF + up to
# 500 PNG pages); larger files are "too_large".
#SX_PREVIEW_MAX_BYTES=1073741824
# Most pages rendered per document (default 500).
#SX_PREVIEW_MAX_PAGES=500
# Largest video that gets a preview, bytes (default 1.5 GiB: leaves about 2.5 GiB of /work
# for the 720p HLS output of up to SX_PREVIEW_MAX_VIDEO_SECONDS).
#SX_PREVIEW_MAX_VIDEO_BYTES=1610612736
# Longest video that gets a preview, seconds (default 7200).
#SX_PREVIEW_MAX_VIDEO_SECONDS=7200
# Resolution document pages are rendered at (default 110; pages are capped at 2000 px).
#SX_RENDER_DPI=110
# Download trace marks. Largest file marked in memory / analysed by the trace page, bytes (default 256 MiB).
#SX_MARK_MAX_BYTES=268435456
# Largest image marked, in pixels (default 50000000).
#SX_MARK_MAX_PIXELS=50000000
# warn (default) delivers a weaker mark when a file cannot be fully marked; block refuses the download.
#SX_UNMARKABLE_POLICY=warn
# Worker scratch directory for decrypted plaintext; must already exist and be a tmpfs (compose mounts /work).
#SX_WORKER_TMP=/work
# The worker refuses to start unless SX_WORKER_TMP is a tmpfs (Linux). Set to 1 only for
# development/tests on a normal directory: plaintext then lands on disk.
#SX_WORKER_ALLOW_NON_TMPFS=
# TTF font used for watermarks burned into video segments.
#SX_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
